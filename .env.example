# 复制为仓库根 .env 后填写。.env 已被 gitignore。
#   cp .env.example .env
# Docker 一键：./scripts/dev.sh docker
# 空的 INVESTIGATOR_MASTER_KEY 会在首次 docker 命令里自动生成。

# 本机 Docker 引导超管（用户名默认 admin）。上线前务必改掉。
INVESTIGATOR_BOOTSTRAP_USER=admin
INVESTIGATOR_BOOTSTRAP_PASSWORD=admin123456

# Base64 编码的 32 字节 AES-256。页面里保存的模型 Key / MCP 凭据靠它加密。
# 可留空，./scripts/dev.sh docker 会写入 openssl rand -base64 32
INVESTIGATOR_MASTER_KEY=

# 模型（可选）。不填也能打开页面，排查会降级报告。配好后也可在「模型」页改。
INVESTIGATOR_MODEL_DASHSCOPE_API_KEY=
# INVESTIGATOR_MODEL_OPENAI_API_KEY=
# INVESTIGATOR_MODEL_OPENAI_BASE_URL=https://api.deepseek.com
# INVESTIGATOR_MODEL_ANTHROPIC_API_KEY=

# 可选：飞书登录 / 群机器人
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_BOT_ENABLED=false
# FEISHU_VERIFICATION_TOKEN=
# 有穿透时一般不用填。登录页开在哪个域名，回调就跟哪个域名。
# FEISHU_REDIRECT_URI=http://your-tunnel.example/api/auth/feishu/callback
