# Profile names are exposed to the agent; values are never returned by MCP.
SRE_DEFAULT_PROFILE=test
SRE_MYSQL_PROFILES_JSON={"test":"mysql://readonly_user:REPLACE_ME@mysql-test.example.com:3306/app"}
SRE_REDIS_PROFILES_JSON={"test":"redis://readonly_user:REPLACE_ME@redis-test.example.com:6379/0"}

# Optional observability sources.
SRE_ES_URL=https://elasticsearch-test.example.com:9200
SRE_ES_API_KEY=REPLACE_ME
SRE_LOG_ENDPOINT=https://logs-test.example.com/search
SRE_LOG_AUTHORIZATION=Bearer REPLACE_ME

# Optional JSONL audit destination. Keep it outside the repository.
SRE_AUDIT_LOG_PATH=/var/tmp/sre-investigator-audit.jsonl

# Code access is restricted to these logical names and absolute roots.
SRE_CODE_WORKSPACES_JSON={"admin":"/absolute/path/demo-admin-broad","app":"/absolute/path/demo-app-broad"}
