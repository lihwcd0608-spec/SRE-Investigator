# 复制为 scripts/local.env 后填写。local.env 已被 gitignore，不要提交。
#   cp scripts/local.env.example scripts/local.env
#
# 配置说明见 docs/config-profiles.md
# 本机：application-local.yml；远程：application-test|pre|prod.yml
# 模型 / 飞书：本地自建 application-model.yml、application-secrets.yml

# --- 运行环境。不写则默认 local
# SPRING_PROFILES_ACTIVE=local
# SPRING_PROFILES_ACTIVE=test
# SPRING_PROFILES_ACTIVE=local,mcp

# --- Node MCP / 代码仓。开 mcp 时才需要
SRE_MCP_NODE_COMMAND=node
SRE_MCP_SERVER_PATH=
SRE_CODE_WORKSPACES_JSON={"admin":"/Users/yourname/IdeaProjects/workspaces/demo-admin-broad","app":"/Users/yourname/IdeaProjects/workspaces/demo-app-broad"}
